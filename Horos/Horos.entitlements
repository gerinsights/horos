<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime, no App Sandbox (medical filesystem access patterns) -->

	<!-- DICOM network: outbound C-FIND, C-MOVE, C-GET, C-STORE, WADO -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- DICOM network: inbound C-STORE SCP listener -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- Open DICOM files via user file panels -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Read/write DICOM database and preference directories -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<!-- Allow loading unsigned plugins during development -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>

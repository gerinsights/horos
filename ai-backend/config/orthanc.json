{
  "Name": "AI_SEGMENT",
  "DicomAet": "AI_SEGMENT",
  "DicomPort": 4242,
  "HttpPort": 8042,

  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {
    "ai-service": "change-me-in-env"
  },

  "StableAge": 10,

  "DicomModalities": {
    "PACS_CORE": ["PACS_CORE", "localhost", 4242],
    "HOROS_M1": ["HOROS_M1", "localhost", 11112]
  },

  "LuaScripts": ["/etc/orthanc/lua/orthanc-routing.lua"],

  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db",

  "MaximumStorageSize": 0,
  "MaximumPatientCount": 0,

  "DicomCheckCalledAet": true,
  "UnknownSopClassAccepted": true,

  "ConcurrentJobs": 2,

  "DicomTlsEnabled": true,
  "DicomTlsCertificate": "/etc/orthanc/certs/server.crt",
  "DicomTlsPrivateKey": "/etc/orthanc/certs/server.key",
  "DicomTlsTrustedCertificates": "/etc/orthanc/certs/ca.crt",
  "DicomTlsRemoteCertificateRequired": false,

  "SslEnabled": false,
  "SslCertificate": "",

  "HttpsCACertificates": "/etc/orthanc/certs/ca.crt",

  "DicomAlwaysAllowEcho": true,
  "DicomAlwaysAllowFind": false,
  "DicomAlwaysAllowFindWorklist": false,
  "DicomAlwaysAllowGet": false,
  "DicomAlwaysAllowMove": false,
  "DicomAlwaysAllowStore": true
}

# DICOM Segmentation Backend — Environment Configuration
# Copy to .env and customize for your host.

# ── GPU Backend ──
# Options: rocm, cuda, cpu
GPU_BACKEND=cpu

# ROCm: Set to your GPU's GFX version (leave empty for auto-detect)
# Examples: 11.0.2 (RX 7600 XT), 10.3.0 (RX 6700 XT), 9.0.6 (MI100)
HSA_OVERRIDE_GFX_VERSION=

# ── DICOM ──
DICOM_PORT=4242
PACS_AE=PACS
PACS_HOST=localhost
PACS_PORT=4242

# ── HTTPS ──
HTTPS_PORT=8443

# ── MCP ──
MCP_PORT=3001

# ── LLM (Ollama) ──
OLLAMA_MODEL=llama3.2:3b
